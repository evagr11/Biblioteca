<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="12.0" style="-fx-background-color: white; -fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; -fx-font-size: 14px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ConfirmarController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label fx:id="lblTitulo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1c2b2a;" text="¿Seguro que quieres eliminar?" wrapText="true" />
      <Label fx:id="lblMensaje" style="-fx-text-fill: #63746f;" text="Esta acción no se puede deshacer." wrapText="true" />
      <HBox spacing="8.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" style="-fx-background-color: white; -fx-border-color: #d6dfda; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: #1c2b2a; -fx-cursor: hand;" text="Cancelar" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" style="-fx-background-color: white; -fx-border-color: #b2443a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: #b2443a; -fx-cursor: hand;" text="Eliminar" />
         </children>
         <VBox.margin>
            <Insets top="6.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
