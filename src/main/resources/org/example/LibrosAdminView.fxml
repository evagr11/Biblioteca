<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1180.0" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom right, #dfe7e3, #cfdcd6); -fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; -fx-font-size: 14px; -fx-text-fill: #1c2b2a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.LibrosAdminController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" spacing="4.0" style="-fx-background-color: #fbfcfb; -fx-background-radius: 999; -fx-border-color: #d6dfda; -fx-border-radius: 999; -fx-padding: 4;">
         <children>
            <Label style="-fx-text-fill: #63746f; -fx-padding: 0 8 0 12;" text="Ventana:" />
            <Button mnemonicParsing="false" onAction="#irPrincipal" style="-fx-background-color: transparent; -fx-background-radius: 999; -fx-text-fill: #1c2b2a; -fx-padding: 7 16 7 16; -fx-cursor: hand;" text="Principal" />
            <Button mnemonicParsing="false" onAction="#irLibros" style="-fx-background-color: #2f6b5e; -fx-background-radius: 999; -fx-text-fill: white; -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-font-weight: bold;" text="Administrar libros" />
            <Button mnemonicParsing="false" onAction="#irAutores" style="-fx-background-color: transparent; -fx-background-radius: 999; -fx-text-fill: #1c2b2a; -fx-padding: 7 16 7 16; -fx-cursor: hand;" text="Administrar autores" />
         </children>
      </HBox>
      <VBox style="-fx-background-color: #fbfcfb; -fx-background-radius: 14; -fx-border-color: #d6dfda; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(28,43,42,0.28), 32, 0, 0, 12);" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f3; -fx-background-radius: 14 14 0 0; -fx-border-color: transparent transparent #d6dfda transparent; -fx-padding: 12 18 12 18;">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Mi biblioteca – Administrar libros" />
               </children>
            </HBox>
            <HBox alignment="TOP_LEFT" spacing="20.0" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <children>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Buscar libro" />
                                    <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtBuscar" onKeyReleased="#buscar" promptText="Título o autor" />
                                 </children>
                              </VBox>
                              <Button mnemonicParsing="false" onAction="#irAutores" style="-fx-background-color: white; -fx-border-color: #d6dfda; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: #1c2b2a; -fx-cursor: hand;" text="Autores" />
                              <Button mnemonicParsing="false" onAction="#irPrincipal" style="-fx-background-color: white; -fx-border-color: #d6dfda; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: #1c2b2a; -fx-cursor: hand;" text="Volver" />
                           </children>
                        </HBox>
                        <TableView fixedCellSize="38.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d6dfda; -fx-border-radius: 10; -fx-padding: 0;" fx:id="tblLibros" onMouseClicked="#seleccionarLibro" prefHeight="520.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colTitulo" prefWidth="330.0" text="Título" />
                              <TableColumn fx:id="colAutor" prefWidth="330.0" text="Autor" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox minWidth="380.0" prefWidth="380.0" spacing="12.0" style="-fx-background-color: #f1f5f3; -fx-background-radius: 12; -fx-border-color: #d6dfda; -fx-border-radius: 12; -fx-padding: 20;">
                     <children>
                        <Label fx:id="lblFormTitulo" style="-fx-font-family: Georgia, 'Times New Roman', serif; -fx-font-size: 22px; -fx-font-weight: bold;" text="Nuevo libro" />
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Título *" />
                              <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtTitulo" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Autor *" />
                              <ComboBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="cmbAutor" maxWidth="1.7976931348623157E308" promptText="Elige un autor" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Ubicación *" />
                              <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtUbicacion" promptText="Salón, estante 2" />
                           </children>
                        </VBox>
                        <GridPane hgap="12.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                           </columnConstraints>
                           <children>
                              <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Edición" />
                                    <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtEdicion" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Nº de páginas" />
                                    <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtNumPag" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Año" />
                                    <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtAnio" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Idioma" />
                                    <TextField style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtIdioma" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Tipo" />
                              <HBox spacing="14.0">
                                 <children>
                                    <RadioButton fx:id="rbBolsillo" mnemonicParsing="false" text="bolsillo">
                                       <toggleGroup>
                                          <ToggleGroup fx:id="grupoTipo" />
                                       </toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="rbTapaBlanda" mnemonicParsing="false" text="tapa blanda" toggleGroup="$grupoTipo" />
                                    <RadioButton fx:id="rbTapaDura" mnemonicParsing="false" text="tapa dura" toggleGroup="$grupoTipo" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #63746f;" text="Sinopsis" />
                              <TextArea style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d6dfda; -fx-border-radius: 8; -fx-padding: 4 6 4 6;" fx:id="txtSinopsis" prefRowCount="3" wrapText="true" />
                           </children>
                        </VBox>
                        <Label fx:id="lblError" style="-fx-text-fill: #b2443a; -fx-font-weight: bold; -fx-min-height: 20;" />
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnGuardar" onAction="#guardar" mnemonicParsing="false" style="-fx-background-color: #2f6b5e; -fx-border-color: #2f6b5e; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: white; -fx-cursor: hand;" text="Guardar" />
                              <Button fx:id="btnNuevo" onAction="#nuevo" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #d6dfda; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: #1c2b2a; -fx-cursor: hand;" text="Nuevo" />
                              <Button fx:id="btnEliminar" onAction="#eliminar" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: #b2443a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-text-fill: #b2443a; -fx-cursor: hand;" text="Eliminar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox style="-fx-background-color: #f1f5f3; -fx-background-radius: 0 0 14 14; -fx-border-color: #d6dfda transparent transparent transparent; -fx-padding: 9 18 9 18;">
               <children>
                  <Label fx:id="lblEstado" style="-fx-font-size: 12px; -fx-text-fill: #63746f;" text="Listo" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
